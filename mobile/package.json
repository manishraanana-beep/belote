    "@capacitor/ios": "7.6.10",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@capgo/capacitor-social-login": "7.20.0",
    "@capgo/native-purchases": "7.19.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.10"
  }
